{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gpower2-api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "gpower2.http_api:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "gpower2-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8001", "--directory", "web"],
      "port": 8001
    }
  ]
}
